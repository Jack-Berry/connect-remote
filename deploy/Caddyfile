# Caddy v2 config for the hosted proxy.
#
# Auto-HTTPS: Caddy obtains and renews the Let's Encrypt certificate for the
# site address by itself — the only prerequisites are the DNS A record
# pointing here and ports 80/443 open.
#
# Access logs are deliberately NOT enabled (no `log` directive): request logs
# would record client IPs and request lines for an app whose every request
# carries car credentials in the body. Caddy 2 only writes per-site access
# logs when explicitly configured, so leaving `log` out keeps them off.

car-proxy.berrydev.co.uk {
	# "proxy" is the app service name on the internal compose network.
	reverse_proxy proxy:8000
}

flight.berrydev.co.uk {
	# Flight Tracker (G2 glasses app) — GET /flight/{iata}, served by the SAME
	# container as car-proxy above. A second hostname rather than a second
	# service, for one reason: the glasses app's app.json whitelists exactly the
	# hosts it may reach, so shipping it `flight.berrydev.co.uk` means a bug (or
	# a tampered build) in that app cannot address the car API at all. Sharing
	# the origin would have handed it the whole surface.
	#
	# The flight endpoint holds no credentials and reads public timetable data,
	# so — unlike the car-proxy block — an access log here would leak nothing.
	# It still isn't enabled: nobody has asked a question that needs one.
	reverse_proxy proxy:8000
}

matchhud.berrydev.co.uk {
	# MatchHUD droplet API — a separate compose project (matchhud), reachable by
	# container name because it joined this same docker network. Port 8090; the
	# Connect Remote proxy above is on 8000.
	reverse_proxy matchhud-api:8090
}

ableshow.app, www.ableshow.app {
	# AbleShow — live performance cues for Ableton + Even Realities G2.
	# Static site served from /srv/ableshow (bind mount of
	# /home/deploy/ableshow-site — see docker-compose.yml). Update the site by
	# rsyncing into that directory; no reload needed for content changes.
	root * /srv/ableshow

	# Private stats dashboard (/stats) — basic auth. The HTML is generated into
	# the webroot at stats/index.html by cron (ableshow-stats/gen-stats.sh); this
	# matcher is the only thing keeping the numbers non-public.
	@stats path /stats /stats/*
	# Credentials live outside this repo -- see docker-compose.yml. The file
	# is mounted read-only from /home/deploy/caddy-secrets on the host.
	import /etc/caddy/secrets/ableshow-stats.caddy

	# Scan-tracked QR target. Every printed/embedded QR encodes /qr, so scans
	# are countable in the access log below — one total across all QR variants
	# (no per-variant breakdown, no analytics service). 302 -> canonical root.
	redir /qr https://ableshow.app/ 302

	# Serve the Max for Live device as a download, never inline. .amxd has no
	# registered MIME type, so without an explicit Content-Type the file could
	# be content-sniffed and rendered as text in the browser.
	@amxd path *.amxd
	header @amxd {
		Content-Type application/octet-stream
		Content-Disposition attachment
	}

	file_server

	# Access log — enabled ONLY for this site block. The global default keeps
	# logs OFF (the car-proxy block MUST stay unlogged; its request bodies carry
	# car credentials). Written to the persisted caddy-data volume (/data) so it
	# survives container restart/recreate. Count /qr scans with:
	#   docker compose exec -T caddy grep -c '"uri":"/qr"' /data/logs/ableshow-access.log
	log {
		output file /data/logs/ableshow-access.log {
			roll_size 100MiB
			roll_keep 100
		}
		format json
	}
}

transit.berrydev.co.uk {
	# London Transit HUD — static app plus TfL/geocode proxy, one origin.
	# API paths go to the transit-proxy container (separate compose project,
	# ~/london-transit-hud/proxy, key injected server-side); everything else is
	# the built web app served from /srv/transit (bind mount of
	# /home/deploy/london-transit-hud-site — rsync new builds there, no reload
	# needed). No access log (global default stays off).
	handle /tfl/* {
		reverse_proxy transit-proxy:8100
	}
	handle /geocode {
		reverse_proxy transit-proxy:8100
	}
	handle /healthz {
		reverse_proxy transit-proxy:8100
	}
	handle {
		root * /srv/transit
		try_files {path} /index.html
		file_server
	}
}

beriscope.co.uk, www.beriscope.co.uk {
	# Beriscope — apps for the Even Realities G2, plus the in-browser HUD
	# simulator. Static site served from /srv/beriscope (bind mount of
	# /home/deploy/beriscope-site — see docker-compose.yml). Update the site by
	# rsyncing a fresh `npm run build` into that directory; no reload needed for
	# content changes.
	#
	# No try_files: this is a multi-page site with real directories
	# (/contact/, /apps/ableshow/, /apps/connect-remote/), so file_server's own
	# directory-index handling is correct. An SPA-style fallback here would
	# serve the homepage for every typo instead of a 404.
	#
	# Both hostnames serve the same files rather than redirecting: every page
	# already carries <link rel="canonical"> pointing at the apex, which is what
	# tells search engines which one counts. Same pattern as the ableshow block.
	#
	# No access log — the global default keeps logs off and this site has no
	# reason to turn them on.
	root * /srv/beriscope
	file_server
}

chatlink.berrydev.co.uk {
	# Even G2 custom-agent Phase 1 logging shim. The container is a separate
	# compose project on connect-remote_default and publishes no host port.
	# No Caddy access log: the application persists the full diagnostic request.
	reverse_proxy even-agent-shim:8000
}
