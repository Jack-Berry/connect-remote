# Secrets for docker compose. Copy to .env on the server and fill in.
# .env is gitignored (see .gitignore); .env.example is the committed template.
# Docker Compose reads .env from the directory you run `docker compose` in.

# Gate for GET /debug/shapes (X-Debug-Token header). Unset = 404 for everyone.
SHAPES_DEBUG_TOKEN=

# aviationstack API key for GET /flight/{flight_iata} — https://aviationstack.com
#
# FREE PLAN, TWO CONSEQUENCES, both handled in backend/app/flight.py:
#   - HTTPS is paid-only, so the upstream hop is plain HTTP. Nothing secret
#     crosses it except this key, which is why the key is here and rotatable
#     rather than in the repo.
#   - 100 requests per MONTH. The endpoint caches per flight number for 5
#     minutes and caches failures for 60s; without both, one polling client
#     would exhaust the month in an afternoon.
#
# Unset = GET /flight/... answers 503 "not configured". The rest of the
# service (every car endpoint) runs perfectly well without it.
AVIATIONSTACK_KEY=
